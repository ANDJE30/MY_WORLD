# Base de données PostgreSQL (Neon recommandé). Sur Vercel, l'intégration Neon remplit DATABASE_URL automatiquement.
DATABASE_URL=postgres://svtc:svtc@localhost:5432/svtc

# Mot de passe initial du compte administrateur « admin » (créé au premier démarrage s'il n'existe aucun administrateur).
ADMIN_PASSWORD=ChangezMoi@2026

# Adresse publique de l'application (liens dans les SMS et QR codes de vérification). Facultatif sur Vercel.
APP_URL=https://svtc-repetitions.vercel.app

# --- Passerelle SMS (facultatif) : SIMULATION | TWILIO | ORANGE | AFRICASTALKING ---
SMS_PROVIDER=SIMULATION
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Orange SMS API (Orange Developer, Cameroun)
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
ORANGE_SENDER_PHONE=
ORANGE_SENDER_NAME=SVTC
# Africa's Talking
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

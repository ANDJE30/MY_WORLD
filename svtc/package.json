{
  "name": "svtc-repetitions",
  "version": "1.0.0",
  "private": true,
  "description": "SVTC Répétitions — plateforme de gestion du soutien scolaire de la Silicon Valley Training Center (Yaoundé, Cameroun)",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/migrate.mjs && next build",
    "build:app": "next build",
    "start": "next start",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "seed:demo": "tsx --conditions=react-server scripts/seed-demo.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:e2e": "node tests/e2e/flows.cjs"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "@react-pdf/renderer": "^4.9.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.70.0",
    "next": "^16.4.6",
    "papaparse": "^5.7.1",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "^19.2.9",
    "react-dom": "^19.2.9",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2",
    "@types/react-dom": "19.2",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}

flowchart LR
  subgraph CLIENTS["Terminaux (navigateur ou application installée PWA)"]
    PC["💻 Ordinateur<br/>administration"]
    TAB["📱 Tablette"]
    TEL["📱 Smartphone<br/>enseignants / surveillants"]
  end
  subgraph CLOUD["Serveur d'hébergement"]
    direction TB
    RP["Proxy HTTPS<br/>Caddy / Render<br/>(TLS Let's Encrypt)"]
    subgraph CT["Conteneur Node.js 22"]
      APP["EduGest CM<br/>Express 5 — API REST<br/>+ fichiers statiques SPA"]
      PDF["Moteur PDF<br/>(PDFKit)"]
      CALC["Moteur de calcul<br/>moyennes / rangs"]
    end
    DB[("SQLite (WAL)<br/>/data/edugest.db")]
    BK[("Sauvegardes auto<br/>/data/backups (14 j)")]
  end
  PC & TAB & TEL -- "HTTPS 443" --> RP
  RP -- "HTTP interne :3000" --> APP
  APP --- PDF & CALC
  APP --> DB
  DB -. "VACUUM INTO<br/>toutes les 6 h" .-> BK
  classDef n fill:#e8f5f0,stroke:#0b5d4b,color:#0b2e25

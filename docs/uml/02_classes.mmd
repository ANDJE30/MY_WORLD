  class CampagneMessages {
    +titre, modele, texte avec champs
    +canal : sms|manuel
    +total, envoyes, echecs
  }
  class MessageParent {
    +telephone, parent, enfants, classes
    +message personnalise
    +statut : a_envoyer|envoye|simule|echec
  }
  class PasserelleSMS {
    +fournisseur : Africa's Talking|Twilio|Orange|simulation
    +identifiant, cleChiffree, expediteur
    +envoyer(numero, texte)
  }
  Administrateur "1" -- "0..*" CampagneMessages : envoie
  CampagneMessages "1" *-- "1..*" MessageParent
  MessageParent "0..*" -- "1..*" Eleve : concerne
  Entreprise "1" -- "0..1" PasserelleSMS : configure
  CampagneMessages ..> PasserelleSMS : canal sms
  class Chronogramme {
    +titre, annee, fichier Word ou PDF
    +lire() lignes du tableau
    +extraireEcheances() propositions
  }
  class Echeance {
    +titre, dateLimite, destinataire
    +periodicite : ponctuel|mensuel|sequentiel|trimestriel|annuel
    +rappelJours
    +etat() : a_venir|bientot|aujourdhui|retard|depose
    +deposer(date, piece, observation)
  }
  class ModeleWord {
    +type : effectifs|resultats|couverture|assiduite|discipline|...
    +generer(echeance) docx pre-rempli
  }
  Administrateur "1" -- "0..*" Chronogramme : importe
  Chronogramme "0..1" *-- "0..*" Echeance : extraites
  Echeance "0..*" --> "1" ModeleWord : propose
  Echeance ..> Etablissement : en-tête officiel, données

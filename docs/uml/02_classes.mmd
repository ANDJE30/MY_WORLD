classDiagram
  direction LR
  class Entreprise {
    +raisonSociale = AI721 TECH STUFF
    +contacts, RCCM, NIU, tarif
  }
  class SuperAdministrateur
  class EtablissementAbonne {
    +code (adresse /e/code)
    +statut : actif|suspendu
    +identifiantAdmin, motDePasseChiffre
  }
  class Abonnement {
    +anneeScolaire, du 01/09 au 31/08
    +montant, paye, mode, reference
    +estValide(date)
  }
  class Etablissement {
    +nom, sigle, immatriculation
    +type, statut, sousSysteme
    +delegations, logo, devise
    +anneeScolaire, seuilReussite
    +joursActifs, creneauxHoraires
  }
  class Utilisateur {
    <<abstract>>
    +id, identifiant, motDePasseHache
    +nomComplet, telephone, email
    +actif, motDePasseGenereChiffre (coffre)
    +seConnecter()
    +changerMotDePasse()
  }
  class Administrateur
  class Enseignant {
    +specialite, matricule, grade, statut
    +fonction, diplome, datePriseService
    +acteAffectation
    +tauxAssiduite(periode)
  }
  class Pointage {
    +date, nature : absence|retard
    +heures, minutes, creneau
    +justifie, motif
  }
  class JourNonOuvre { +date, libelle }
  class DocumentAdministratif {
    <<abstract>>
    +reference N° nnn/annee/sigle/code
    +date, objet, faits, ampliations
    +agentFige, signataireFige
    +statut : emis|repondu|clos|annule
    +remiseLe, suiteReservee
    +annuler(motif)
  }
  class AttestationPresenceEffective { +periode, heuresDues, heuresEffectuees, tauxAssiduite }
  class CertificatPriseDeService
  class RappelALOrdre
  class LettreObservation
  class DemandeExplication {
    +delaiHeures, echeance
    +reponse, reponseLe
    +repondre(texte)
  }
  class ResponsableDisciplinaire { +fonction }
  class Classe { +nom, niveau, serie, cycle, salle }
  class Matiere { +intitule, code }
  class GroupeMatiere { +libelle, position }
  class TypeMatiere { +libelle }
  class Attribution { +coefficient, heuresParSemaine }
  class Eleve {
    +matricule, nom, prenom, sexe
    +dateNaissance, lieuNaissance
    +redoublant, parent, telephoneParent
  }
  class Sequence {
    +numero [1-6], dateDebut, dateFin
    +statut : ouverte|cloturee
    +cloturer(forcer)
    +rouvrir()
  }
  class Trimestre { +numero [1-3] }
  class Note { +valeur [0-20], absent }
  class Progression { +leconsPrevues, leconsFaites, observation }
  class FicheDisciplinaire {
    +absJustifiees, absNonJustifiees, retards
    +consignes, avertissement, blame
    +joursExclusion, observation
  }
  class Incident { +date, nature, gravite, sanction, description }
  class CreneauEDT { +jour, creneau, salle }
  class Annonce { +titre, message, destinataires }
  class JournalAudit { +date, action, detail, ip }
  Utilisateur <|-- SuperAdministrateur
  Entreprise "1" o-- "1..*" SuperAdministrateur
  Entreprise "1" o-- "0..*" EtablissementAbonne : commercialise
  EtablissementAbonne "1" *-- "1..*" Abonnement
  EtablissementAbonne "1" -- "1" Etablissement : base dédiée
  Utilisateur <|-- Administrateur
  Utilisateur <|-- Enseignant
  Utilisateur <|-- ResponsableDisciplinaire
  Classe "1" o-- "0..*" Eleve : inscrit
  Classe "1" *-- "0..*" Attribution
  Matiere "1" -- "0..*" Attribution
  GroupeMatiere "1" -- "0..*" Matiere : regroupe
  TypeMatiere "1" -- "0..*" Matiere : qualifie
  Enseignant "0..1" -- "0..*" Attribution : enseigne
  Enseignant "0..1" -- "0..*" Classe : professeur principal
  ResponsableDisciplinaire "0..*" -- "0..*" Classe : a la charge de
  Trimestre "1" *-- "2" Sequence
  Eleve "1" -- "0..*" Note
  Attribution "1" -- "0..*" Note
  Sequence "1" -- "0..*" Note
  Attribution "1" -- "0..6" Progression
  Eleve "1" -- "0..6" FicheDisciplinaire
  Eleve "1" -- "0..*" Incident
  Attribution "1" -- "0..*" CreneauEDT
  Administrateur "1" -- "0..*" Annonce : publie
  Utilisateur "1" -- "0..*" JournalAudit : génère
  Enseignant "1" -- "0..*" Pointage : absences et retards
  Pointage "0..*" -- "0..1" CreneauEDT : sur le créneau
  Etablissement "1" -- "0..*" JourNonOuvre
  Enseignant "1" -- "0..*" DocumentAdministratif : destinataire
